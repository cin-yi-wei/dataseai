# dataseai master key — used to AES-encrypt connection passwords + OAuth tokens
# Generate with: openssl rand -hex 32
MYSQLWEB_MASTER_KEY=

# Cloudflare Tunnel token (long base64 string, starts with eyJ...)
# Get from: Cloudflare Zero Trust -> Networks -> Tunnels -> [your tunnel] -> Install connector -> Docker
CLOUDFLARED_TOKEN=
