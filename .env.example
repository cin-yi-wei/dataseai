# 64-char hex (32 bytes) — generate with: openssl rand -hex 32
# If omitted, dataseai will generate one at ./data/master.key on first launch.
# Store this somewhere safe — losing it means losing every encrypted secret
# (connection passwords, OAuth tokens, LLM API keys).
MYSQLWEB_MASTER_KEY=

# open | closed
MYSQLWEB_REGISTRATION=open

# Optional overrides
# MYSQLWEB_PORT=53306
# MYSQLWEB_HISTORY_MAX=1000
# MYSQLWEB_QUERY_TIMEOUT_S=5
# MYSQLWEB_QUERY_HTTP_MAX_MB=10

# --- AI Chat --------------------------------------------------------------
# Default provider when chat clients don't specify.
# MYSQLWEB_LLM_DEFAULT=anthropic   # anthropic|openai|gemini|claudecode|codex
#
# Server-wide LLM API keys (per-user keys configured in Settings take
# precedence — these are only the fallback for unauthenticated / no-key
# users, useful for dev/test).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
#
# Claude Code / ChatGPT subscription auth is configured per-user via
# Settings → API keys → Connect Claude / Connect ChatGPT. No env needed.
