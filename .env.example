# 64-char hex (32 bytes) — generate with: openssl rand -hex 32
# If omitted, mysqlweb will generate one at ./data/master.key on first launch.
MYSQLWEB_MASTER_KEY=

# open | closed
MYSQLWEB_REGISTRATION=open

# Optional overrides
# MYSQLWEB_PORT=53306
# MYSQLWEB_HISTORY_MAX=1000
# MYSQLWEB_QUERY_TIMEOUT_S=5
# MYSQLWEB_QUERY_HTTP_MAX_MB=10

# --- AI Chat (Plan 5) -----------------------------------------------------
# At least one of ANTHROPIC_API_KEY / OPENAI_API_KEY enables the chat tab.
# MYSQLWEB_LLM_DEFAULT picks the provider when chat clients don't specify.
# MYSQLWEB_LLM_DEFAULT=anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# Optional MCP server (recommended path, matches design spec §9).
# mysqlweb spawns the command on startup and speaks JSON-RPC over its
# stdin/stdout. MYSQL_MCP_EXTENDED=1 is added to the subprocess env so
# askdba's add_connection / remove_connection tools are available.
# If unset, /ws/chat falls back to the direct-tools path (in-process tool
# execution via internal/mysql).
#
# Examples (uncomment one):
#   MYSQLWEB_MCP_COMMAND=npx -y @askdba/mcp-server-mysql
#   MYSQLWEB_MCP_COMMAND=/usr/local/bin/mcp-server-mysql
